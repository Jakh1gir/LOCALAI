{
  "version": 1,
  "profiles": {
    "c101": {
      "description": "База оборудования генератора C-101; любой seed, начиная со 100 записей.",
      "bindings": {
        "operating": {
          "resource": "datasets",
          "name": "В эксплуатации"
        },
        "warehouse": {
          "resource": "datasets",
          "name": "Склад"
        },
        "site": {
          "resource": "site_of",
          "dataset": "operating"
        }
      }
    },
    "c104": {
      "description": "Модель генератора C-104: реестры Сигналы и Кабели, поля Код сигнала и Тип сигнала.",

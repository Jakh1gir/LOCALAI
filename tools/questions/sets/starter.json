        "signals": {
          "resource": "datasets",
          "name": "Сигналы"
        },
        "cables": {
          "resource": "datasets",
          "name": "Кабели"
        },
        "site": {
          "resource": "site_of",
          "dataset": "signals"
        },
        "signal_code": {
          "resource": "field",
          "dataset": "signals",
          "name": "Код сигнала"
        },
        "signal_kind": {
          "resource": "field",
          "dataset": "signals",
          "name": "Тип сигнала"
        },
        "sample": {
          "resource": "sample",
          "dataset": "signals",
          "field": "signal_code"
        }
      }
    }
  },
  "roles": {
    "reader": {
      "description": "Инженер: только чтение всех реестров.",
      "datasets": [
        "*"
      ]
    },
    "operating_only": {
      "description": "Инженер эксплуатации без доступа к складу.",
      "datasets": [
        "operating"
      ]
    },
    "signals_only": {
      "description": "Инженер сигналов без доступа к кабельному реестру.",
      "datasets": [
        "signals"
      ]
    }
  },
